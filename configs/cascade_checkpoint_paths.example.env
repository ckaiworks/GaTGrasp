# Copy this file outside Git, replace /your_path with your actual directory,
# then export it. Example: /your_path -> /home/alice/ActiveTouchGS_workspace
#   export ACTIVETOUCHGS_CASCADE_CONFIG=/your_path/configs/cascade_checkpoint_paths.env

# Activate the environment first: conda activate atgs
PYTHON_BIN=python
CUDA_DEVICE=0

# Each data root may be either the directory containing folds/ directly or
# its parent containing withGS/folds/. The CSV rows must resolve all external
# RGB, GS NPZ and tactile paths on the machine that performs inference.
STAGE1_DATA_ROOT=/your_path/ActiveTouchGS_runtime_indexes/stage1
STAGE2_DATA_ROOT=/your_path/ActiveTouchGS_runtime_indexes/stage2

# Stage 1 expects fold_0 ... fold_4 with best_fullobject_softtop1.pt and
# fullobject_feature_stats.npz. Stage 2 expects checkpoint_epoch_050.pt and
# fullobject_feature_stats.npz in every fold directory.
STAGE1_RUN_ROOT=/your_path/runs/stage1_final_seed42
STAGE2_FULLGS_RUN_ROOT=/your_path/runs/stage2_stage1backbone_old12_touch_seed42

# Must not already exist; the evaluator writes atomically via .building.
CASCADE_CHECKPOINT_OUT=/your_path/runs/final_stage1_to_stage2_fullgs

# Optional execution controls.
CASCADE_BATCH_SIZE=32
CASCADE_NUM_WORKERS=0
CASCADE_REFERENCE_PROBABILITY_TOLERANCE=0.00001
# 1 makes the run fail if checkpoint probabilities drift beyond the tolerance.
CASCADE_REQUIRE_REFERENCE_PROBABILITIES=1
