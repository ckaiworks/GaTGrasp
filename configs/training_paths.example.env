# Copy this file outside Git, replace /your_path with your actual directory,
# then export it. Example: /your_path -> /home/alice/ActiveTouchGS_workspace
#   export ACTIVETOUCHGS_TRAINING_CONFIG=/your_path/configs/training_paths.env

# Activate the environment first: conda activate atgs
PYTHON_BIN=python
CUDA_DEVICE=0

# Stage 1 and Stage 2 both launch all five folds concurrently.
STAGE2_MAX_PARALLEL=5

# Extract ActiveTouchGS_external_files.zip once and point to its dataset directory.
# Training reads metadata/stage1 and metadata/stage2 directly; no second index
# tree is generated.
DATASET_ROOT=/your_path/ActiveTouchGS_external_files/ActiveTouchGS_dataset

# These output directories must not already exist.
STAGE1_RUN_ROOT=/your_path/runs/stage1_final_seed42
STAGE2_RUN_ROOT=/your_path/runs/stage2_stage1backbone_old12_touch_seed42
