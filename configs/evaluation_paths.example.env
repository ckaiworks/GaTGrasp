# Copy to configs/evaluation_paths.env (ignored by Git), replace /your_path,
# and edit as needed. Example: /your_path -> /home/alice/ActiveTouchGS_workspace
# Activate the environment first: conda activate atgs
PYTHON_BIN=python

# The packaged defaults below reproduce the release table without a GPU.
STAGE1_SELECTION_CSV=/your_path/ActiveTouchGS_github_release/reports/final_stage1_selection/selected_stage1_current_repro17of19_withGS_top1.csv
STAGE2_OOF_ROOT=/your_path/ActiveTouchGS_github_release/reports/final_stage2_oof

# Must not already exist.
FINAL_CASCADE_OUT=/your_path/output/final_cascade_reproduction
